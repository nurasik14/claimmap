# Copy to .env and fill in. .env is gitignored.

# Claude API key. With a key, ClaimMap calls the API directly (fastest, and the only mode with web fact-checks).
# Without one it falls back to the `claude` CLI (Claude Code, logged in with a Pro/Max plan): no web checks.
ANTHROPIC_API_KEY=

# Optional overrides
# CLAIMMAP_API_MODEL_FAST=claude-haiku-5-5     # claim extraction, live claims
# CLAIMMAP_API_MODEL_SMART=claude-sonnet-5-5   # web checks, questions, the Brief
# CLAIMMAP_WHISPER_MODEL=small.en              # faster-whisper model for live speech-to-text
# CLAIMMAP_DECK_NO_WEB=1                       # skip web checks (weak Wi-Fi / offline demo)
# CLAIMMAP_LLM_LOG=1                           # print the latency of every LLM call
